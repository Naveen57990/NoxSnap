<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0D14">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/layoutHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.04"
                    android:text="NoxSnap"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hardware Magnetic Handoff • 100% Deterministic"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

            <!-- Discovered Mac Pill -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#161824"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#1E2132"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp">

                    <View
                        android:id="@+id/viewOnlineDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_green" />

                    <TextView
                        android:id="@+id/tvDeviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Searching for MacBook on Wi-Fi..."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Live Magnetometer & 3D Kinematics Gauge Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGauge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#141624"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeColor="#252A40"
                app:strokeWidth="1.5dp"
                app:layout_constraintTop_toBottomOf="@id/cardDevice">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvLiveLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="LIVE HARDWARE SENSORS &amp; KINEMATICS"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMagnitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="42 µT"
                        android:textColor="#06B6D4"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVectorDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Yaw: 0.0°  |  Roll: 0.0°"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <!-- Live Detected Zone Pill -->
                    <TextView
                        android:id="@+id/tvFieldStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#1E2438"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="⚪ Ambient Earth Field"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Strength Progress Bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressStrength"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="10dp"
                        android:max="500"
                        android:progress="42"
                        app:indicatorColor="#06B6D4"
                        app:trackColor="#1E2235"
                        app:trackCornerRadius="3dp" />

                    <TextView
                        android:id="@+id/tvDockHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Touch MacBook top-left (Pull) or top-right (Push)"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Ready-to-Push Link Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPushTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#16152B"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#3B2A66"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cardGauge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚀"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="READY TO BEAM TO MAC"
                            android:textColor="#C084FC"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActivePushUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:text="https://google.com"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteUrl"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:paddingHorizontal="10dp"
                        android:text="📋 Paste"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:backgroundTint="#3B2D5A"
                        app:cornerRadius="17dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Calibration Card (Hidden: Pure Phone -> Mac Push Active) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#141624"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="#252A40"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cardPushTarget">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎯 Mac Bezel Calibration"
                            android:textColor="#F59E0B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnResetCalib"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="🔄 Reset"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Calibration Status Badge -->
                    <TextView
                        android:id="@+id/tvCalibStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#1E2438"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="⚪ Calibrate once for 100% zero-mistake handoff"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <!-- Calibration Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalibrateLeft"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="👈 Calibrate Left (Pull)"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp"
                            app:backgroundTint="#1E2D4A"
                            app:cornerRadius="22dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalibrateRight"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="4dp"
                            android:text="👉 Calibrate Right (Push)"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp"
                            app:backgroundTint="#311F4D"
                            app:cornerRadius="22dp" />
                    </LinearLayout>

                    <!-- Immunity Gate Status -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🛡️ Immune Gate: Single discrete trigger per physical bezel touch"
                        android:textColor="#10B981"
                        android:textSize="10.5sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option A Directional Zones Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOptionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#141624"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="#252A40"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cardCalibration">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧭 Instant Test Handoff"
                        android:textColor="#10B981"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Left Bezel Description -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#161A2B"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👈 TOP-LEFT LID BEZEL: Mac ➔ Phone (Pull)"
                            android:textColor="#38BDF8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Touch left lid magnet to pull your Mac active tab onto this phone."
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestPull"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="6dp"
                            android:text="🌊 Beam Tab (Left Edge Repel)"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            app:backgroundTint="#242C47"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <!-- Right Bezel Description -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#161A2B"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👉 TOP-RIGHT LID BEZEL: Phone ➔ Mac Chrome"
                            android:textColor="#A78BFA"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Touch right lid magnet to push your phone tab into Mac Chrome."
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestPush"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="6dp"
                            android:text="🌊 Beam Tab (Right Edge Repel)"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            app:backgroundTint="#2E2447"
                            app:cornerRadius="18dp" />
                    </LinearLayout>

                    <!-- Invert Switch (Hidden) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Invert Left / Right Sides"
                            android:textColor="#CBD5E1"
                            android:textSize="12sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchInvert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Background Service Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardServiceToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#141624"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="#252A40"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardOptionA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Background Snap Service"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Works anywhere even when this app is closed"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBackgroundService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Futuristic Holographic Transfer Overlay (Appears during Snap!) -->
    <FrameLayout
        android:id="@+id/layoutAnimationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <!-- Glowing Neon Ripple Pulse View -->
        <View
            android:id="@+id/viewRipplePulse"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-40dp"
            android:background="@drawable/bg_neon_pulse"
            android:alpha="0" />

        <!-- Floating Holographic Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHologram"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="#0D101E"
            app:cardCornerRadius="24dp"
            app:cardElevation="20dp"
            app:strokeColor="#00F2FE"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvHologramIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡️"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/tvHologramTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Beaming to MacBook Air..."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHologramSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="https://..."
                    android:textColor="#00F2FE"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>
